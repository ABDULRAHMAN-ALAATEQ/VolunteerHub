<% if opportunity.errors.any? %>
  <div class="flash alert" role="alert"><strong>Correct the following:</strong>
    <ul><% opportunity.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %></ul>
  </div>
<% end %>
<%= form_with model: opportunity, local: true, class: 'panel padded editor' do |f| %>
  <div class="form-grid">
    <label class="wide">
      Opportunity title<%= f.text_field :title, required: true, maxlength: 120 %>
    </label>
    <label>
      Category<%= f.select :category, Opportunity::CATEGORIES %>
    </label>
    <label>
      Location<%= f.text_field :location, required: true %>
    </label>
    <label class="wide">
      Description<%= f.text_area :description, rows: 5, required: true %>
    </label>
    <label>
      Starts at (Riyadh time)<%= f.datetime_local_field :starts_at, required: true %>
    </label>
    <label>
      Ends at (Riyadh time)<%= f.datetime_local_field :ends_at, required: true %>
    </label>
    <label>
      Capacity<%= f.number_field :capacity, min: 1, max: 10000, required: true %>
    </label>
    <label>
      Status<%= f.select :status, [['Open','open'],['Closed','closed']] %>
    </label>
  </div>
  <div class="actions">
    <%= f.submit 'Save opportunity', class: 'button' %>
    <%= link_to 'Cancel', opportunities_path, class: 'button secondary' %>
  </div>
<% end %>