<div class="login-grid">
  <section class="login-hero">
    <div class="brand">
      <span class="brand-mark">V</span>
      <span>VolunteerHub
        <small>CAMPUS ENGAGEMENT</small>
      </span>
    </div>
    <div>
      <p class="eyebrow">MAKE AN IMPACT</p>
      <h1>Good work.<br>
        Greater impact.</h1>
      <p>Discover meaningful opportunities,
        record your contribution and recognise 
        the time you give to your community.</p>
      <div class="hero-rule"></div>
      <p class="muted-light">One campus. Three connected roles.</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </section>
  <section class="login-form">
    <p class="eyebrow">YOUR CAMPUS PORTAL</p>
    <h2>Welcome back</h2>
    <p class="muted">Sign in to access your volunteering workspace.</p>
    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <label for="email">Email address</label>
      <%= f.email_field :email, required: true, autocomplete: 'username',
    placeholder: 'name@example.edu' %>
      <label for="password">Password</label>
      <%= f.password_field :password, required: true, autocomplete: 'current-password',
    placeholder: 'Enter your password' %>
      <%= f.submit 'Sign in', class: 'button full' %>
    <% end %>
    <% unless Rails.env.production? %>
      <div class="demo-box"><strong>Local demonstration accounts</strong>
        <p>Password: <code>Volunteer123!</code></p>
        <% [['Student','student@demo.test'],
        ['Organization','organization@demo.test'],
        ['Deanship','deanship@demo.test']].each do |role,email| %>
          <button type="button" class="demo-account" data-email="<%= email %>">
            <span><%= role %></span>
            <small><%= email %></small>
            <span aria-hidden="true">↗</span>
          </button>
        <% end %>
      </div>
    <% end %>
  </section>
</div>